rules_version = '2';

// Universal Arts & Sports Club Vellur — Cloud Firestore Security Rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ── Public website content: everyone can read, only admins can change ──
    match /slides/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /programs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}     { allow read: if true; allow write: if isAdmin(); }

    // Signed-in members may add photos to the gallery; only admins edit or delete
    match /gallery/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ── Private profiles: each person sees and edits only their own; admins see all ──
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── Membership applications and official members ──
    match /members/{id} {
      // Admins can read all records.
      // Authenticated users can read only their own member document (by userId or doc ID).
      allow read: if isAdmin()
        || (signedIn() && (resource.data.userId == request.auth.uid || id == 'mem_' + request.auth.uid));

      // STRICT: Only authenticated users can submit a pending application for themselves.
      // Validates userId matches auth UID, email matches Firebase token email, and status is pending.
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.email == request.auth.token.email.lower()
            && request.resource.data.status == 'pending');

      // Only admins can approve, reject, renew, update or delete member records.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Membership number counter: only admins atomically issue numbers
    match /counters/{id} {
      allow read, write: if isAdmin();
    }

    // Admin registry: an admin can read their own entry; writes disabled from client SDK
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
