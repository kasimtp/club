# Copy to .env and fill in. `.env` is git-ignored — never commit real keys.
# In Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Firebase (Firestore database + Google sign-in) — free Spark plan is enough ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── ImageKit (all photos & videos) — https://imagekit.io/dashboard/developer/api-keys ──
# Public values (safe in the browser):
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/qzlr0gb0ez
# Server-only secret used by /api/imagekit-auth to sign uploads. NOT prefixed with VITE_,
# so Vite never puts it in the browser bundle.
IMAGEKIT_PRIVATE_KEY=
# Optional: comma-separated sites allowed to request upload signatures
ALLOWED_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# TEMPORARY: allow the hard-coded test admin (clubadmin) on a deployed build.
# It is always on in `npm run dev`. Leave this unset/false for the real live site.
VITE_ENABLE_TEST_ADMIN=false
